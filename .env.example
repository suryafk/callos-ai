# CallOS AI — copy to .env and adjust. Never commit .env.
# The values below are safe ONLY for local development. With CALLOS_ENV=demo or
# production the backend refuses to start until the keys (and demo codes) are changed.

# development | demo (public hackathon demo) | production (demo authentication is refused)
CALLOS_ENV=development

# SQLite locally. PostgreSQL example: postgresql://user:password@host:5432/callos
CALLOS_DATABASE_URL=sqlite:///./callos.db

# Server-to-server credential Bolna sends on every tool call (Authorization: Bearer ...).
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
CALLOS_TOOL_API_KEY=dev-tool-key-change-me

# Credential for the admin dashboard and inspection API (X-Admin-Key header). Must differ from the tool key.
CALLOS_ADMIN_API_KEY=dev-admin-key-change-me

# Browser origins allowed to call the API (the dashboard).
CALLOS_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

CALLOS_DEFAULT_TIMEZONE=Asia/Kolkata
CALLOS_ACTION_TTL_MINUTES=15
CALLOS_AUTH_TTL_MINUTES=60
CALLOS_MAX_PIN_ATTEMPTS=5

# --- NON-PRODUCTION demo authentication (spoken access code) -------------------
# Callers say this code to unlock the mock workspace. Not real authentication.
CALLOS_DEMO_AUTH_ENABLED=true
CALLOS_DEMO_USER_PIN=482916
CALLOS_DEMO_SECOND_USER_PIN=731205
CALLOS_SEED_DEMO_DATA=true

# Development-only simulator/reset routes used by the dashboard's API Testing page.
# Always off when CALLOS_ENV=production.
CALLOS_DEV_TOOLS_ENABLED=true

# Development only: session id to use if Bolna does not substitute {call_sid}
# (all such calls then share one session). Leave empty unless you need it.
CALLOS_DEV_FALLBACK_SESSION_ID=

CALLOS_INTEGRATION_MODE=mock
CALLOS_LOG_LEVEL=INFO

# --- Local ports (Makefile and docker-compose) ---------------------------------
BACKEND_PORT=8787
FRONTEND_PORT=5174

# --- Frontend (build time) ------------------------------------------------------
# URL the browser uses to reach the backend. Leave empty in local dev (Vite proxies /api).
VITE_API_BASE_URL=

# --- Optional: only for `bolna/build_agent_payload.py --apply` ------------------
# BOLNA_API_KEY=
